name: Build Notification APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-notif:
    runs-on: ubuntu-22.04

    steps:
      - uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y python3-pip build-essential git libffi-dev libssl-dev zlib1g-dev unzip zip autoconf libtool pkg-config
          python3 -m pip install --upgrade "pip==24.3.1"
          pip install setuptools wheel buildozer cython

      - name: Prepare Android SDK and sdkmanager link
        run: |
          SDK_DIR="/home/runner/.buildozer/android/platform/android-sdk"
          mkdir -p "$SDK_DIR/licenses" "$SDK_DIR/cmdline-tools"
          if [ ! -f "$SDK_DIR/cmdline-tools/latest/bin/sdkmanager" ]; then
            curl -sSL "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" -o /tmp/cmdline-tools.zip
            unzip -q /tmp/cmdline-tools.zip -d "$SDK_DIR/cmdline-tools/tmp_extract"
            mv "$SDK_DIR/cmdline-tools/tmp_extract/cmdline-tools" "$SDK_DIR/cmdline-tools/latest"
            rm -rf "$SDK_DIR/cmdline-tools/tmp_extract" /tmp/cmdline-tools.zip
          fi
          rm -rf "$SDK_DIR/tools"
          ln -sfn "$SDK_DIR/cmdline-tools/latest" "$SDK_DIR/tools"
          (while true; do echo y; done) | "$SDK_DIR/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$SDK_DIR" --licenses >/dev/null || true
          (while true; do echo y; done) | "$SDK_DIR/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$SDK_DIR" "platform-tools" "platforms;android-34" "build-tools;34.0.0"

      - name: Clean old build cache
        run: |
          rm -rf .buildozer/android/platform/android-ndk-*
          rm -rf .buildozer/android/platform/python-for-android
          rm -rf .buildozer/android/platform/build-*

      - name: Build Notification APK with Buildozer
        run: buildozer -f buildozer_notif.spec -v android debug

      - name: Upload Notification APK
        uses: actions/upload-artifact@v4
        with:
          name: apk-dyslexialift-notif
          path: bin/*.apk
